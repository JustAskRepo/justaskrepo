#!/usr/bin/env bash
#
# Runs the same checks CI runs, before the commit is created.
#
# Scoped to what you staged: touching only frontend/ will not compile Rust.
# Checks run against the working tree, not the staged snapshot — if you staged
# part of a file, what is verified is the file on disk.
#
# Enable:  git config core.hooksPath .githooks
# Bypass:  git commit --no-verify     (or SKIP_HOOKS=1 git commit)

set -euo pipefail

if [[ -n "${SKIP_HOOKS:-}" ]]; then
    echo "pre-commit: skipped (SKIP_HOOKS set)"
    exit 0
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [[ -t 1 ]]; then
    bold=$'\033[1m'; red=$'\033[31m'; green=$'\033[32m'; dim=$'\033[2m'; reset=$'\033[0m'
else
    bold=''; red=''; green=''; dim=''; reset=''
fi

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[[ -z "$staged" ]] && exit 0

touches() { grep -q "^$1" <<<"$staged"; }

fail() {
    echo
    echo "${red}${bold}✗ pre-commit failed:${reset} $1"
    echo "${dim}  fix it, or commit with --no-verify to bypass${reset}"
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || fail "$1 not found on PATH"
}

run() {
    local label="$1"; shift
    printf '  %s… ' "$label"
    if output="$("$@" 2>&1)"; then
        echo "${green}ok${reset}"
    else
        echo "${red}FAILED${reset}"
        echo
        echo "$output"
        fail "$label"
    fi
}

if touches backend/; then
    echo "${bold}backend${reset}"
    need cargo
    cd "$root/backend"
    run "cargo fmt --check" cargo fmt --all --check
    run "cargo clippy"      cargo clippy --all-targets --all-features -- -D warnings
    run "cargo test"        cargo test --all-features
    cd "$root"
fi

if touches frontend/; then
    echo "${bold}frontend${reset}"
    need npm
    cd "$root/frontend"
    [[ -d node_modules ]] || fail "frontend/node_modules missing — run 'npm ci' in frontend/"
    run "eslint"    npm run --silent lint
    run "typecheck" npm run --silent typecheck
    cd "$root"
fi
