# ---- JustAskRepo: development images ----
# Nothing is baked in here — source arrives via bind mounts from docker-compose.dev.yml
# and both halves hot-reload. The production single-binary build lives in ./Dockerfile.
#
# Dev topology differs from prod on purpose:
#   prod — Axum serves the API *and* the exported Next.js SPA on one origin (8080)
#   dev  — `next dev` serves the UI on 3001 and proxies /api/* to Axum via the
#          rewrite in next.config.ts, so the browser still sees one origin.

# ---- Rust backend with cargo-watch ----
FROM rust:1-bookworm AS backend-dev
# tree-sitter grammars compile C; TLS clients need openssl headers
RUN apt-get update && apt-get install -y build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
# --locked keeps this layer reproducible; it is the slow part of the image build
RUN cargo install cargo-watch --locked
WORKDIR /app
# Build artifacts go to a named volume, NOT the bind-mounted ./backend/target.
# The host target/ is built against Fedora's glibc and would fight with Debian's.
ENV CARGO_TARGET_DIR=/target
CMD ["cargo", "watch", "-w", "src", "-w", "Cargo.toml", "-x", "run"]

# ---- Next.js dev server (Turbopack HMR) ----
FROM node:22-alpine AS frontend-dev
WORKDIR /app/frontend
# node_modules is a named volume mounted over this path, so install at start
# rather than at build time — see the `web` service command.
CMD ["npm", "run", "dev"]
