# JustAskRepo — environment
#
# Copy to .env and fill in. Every variable here is read exactly once, at
# startup, in backend/src/infrastructure/config.rs — nowhere else in the crate
# (enforced by `cargo test --test architecture`, rule 10).
#
# Anything with a default is optional; the rest fails the process at boot.

# ─── Server ──────────────────────────────────────────────────────────────────
# Where Axum listens. Differs from PUBLIC_URL behind a proxy or in Docker.
BIND_ADDR=0.0.0.0:8080

# How many proxies sit between the internet and Axum. Decides who the rate
# limiter charges and what the login callback records as the session's IP.
#
# X-Forwarded-For is client-writable, so the resolver counts this many entries
# back from the socket peer and treats everything further left as an
# unverifiable claim. 0 ignores the header entirely.
#
#   0  direct, or Docker-published as in compose.yaml (DNAT keeps the source IP)
#   1  behind one nginx / Caddy / ALB
#   2  behind a CDN in front of that
#
# Too high falls back to the peer address; too low costs accuracy. Leaving it
# at 0 behind a proxy puts every user in one shared bucket — set it.
# TRUSTED_PROXY_HOPS=0

# The origin the browser sees. Used to build the OAuth redirect URI and to
# validate the Origin header on mutating requests. No trailing slash.
PUBLIC_URL=http://localhost:3001

# The Next.js static export, served at /. Unused in dev — the Next dev server
# serves the UI and proxies /api/* here.
STATIC_DIR=../frontend/out

# ─── Postgres — durable identity ─────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/justaskrepo?sslmode=require
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_ACQUIRE_TIMEOUT_SECS=10

# ─── Valkey — sessions, OAuth state, WS tickets, rate limits ─────────────────
# On the critical path for every authenticated request. Run with AOF
# persistence; an outage is fail-closed (401), never fail-open. The rate
# limiter is the one exception and fails open on purpose.
VALKEY_URL=redis://localhost:6379
# VALKEY_POOL_SIZE=10

# ─── Qdrant — vectors ────────────────────────────────────────────────────────
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.REGION.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_key_here
# QDRANT_COLLECTION_PREFIX=justaskrepo

# ─── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── GitHub App — identity AND repo access (one app, two token types) ────────
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# The App private key, one of two ways. B64 wins if both are set.
#   B64  — preferred in prod: a PEM's newlines make a plain env var painful.
#          base64 -w0 justaskrepo.private-key.pem
#   PATH — convenient in dev: point at the .pem GitHub gave you.
GITHUB_APP_PRIVATE_KEY_B64=
# GITHUB_APP_PRIVATE_KEY_PATH=./justaskrepo.private-key.pem

# There is deliberately no GITHUB_REDIRECT_URI. It is derived as
# {PUBLIC_URL}/api/auth/github/callback, so the two can never drift apart.

# ─── Sessions ────────────────────────────────────────────────────────────────
# __Host- requires Secure, which browsers only honour on https or localhost.
# Startup rejects the combination of a __Host- name with a non-secure
# PUBLIC_URL rather than letting login silently do nothing.
# SESSION_COOKIE_NAME=__Host-session
# SESSION_ABSOLUTE_TTL_DAYS=30        # hard cap; activity does not extend it
# SESSION_IDLE_TTL_DAYS=7             # sliding, refreshed while active
# SESSION_REFRESH_THRESHOLD_SECS=300  # throttles the TTL-refresh write

# ─── Rate limiting ───────────────────────────────────────────────────────────
# One shared budget per client address across both halves of the GitHub login
# handshake. A real login is two requests, so the default is ten logins a
# minute from one address. Over budget is 429 + Retry-After.
#
# Callers behind one NAT share a bucket; raise the budget if that bites. 0 is
# rejected at boot — it would refuse every login, so it reads as a typo rather
# than an off switch.
# AUTH_RATE_LIMIT_MAX_REQUESTS=20
# AUTH_RATE_LIMIT_WINDOW_SECS=60

# ─── Logging ─────────────────────────────────────────────────────────────────
RUST_LOG=justaskrepo=debug,tower_http=debug,info
